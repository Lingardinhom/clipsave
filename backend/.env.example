# ClipSave Backend Configuration
# Leave API_KEY empty to disable auth (only recommended for local Wi-Fi testing)
API_KEY=change-me-to-a-strong-secret-key

# Public base URL where your server is reachable from iPhone (no trailing slash)
# Example: https://clipsave.yourdomain.com or http://192.168.1.10:8000
PUBLIC_BASE_URL=

# Temporary downloaded files directory & expiration time
TEMP_DIR=/tmp/clipsave
FILE_TTL_SECONDS=600
MAX_FILE_SIZE_MB=500

# Optional Netscape cookies.txt path for Instagram/YouTube age-restricted or datacenter-blocked links
YTDLP_COOKIES_FILE=

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30

# Web UI fallback at /
ENABLE_WEB_UI=true

# Shortcut metadata for update checks
SHORTCUT_VERSION=1.0.0
SHORTCUT_ICLOUD_URL=
